<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MultiTenantApi</RootNamespace>
    <AssemblyName>MultiTenantApi</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Datadog Dynamic Instrumentation needs portable PDBs next to the assembly
         so it can resolve line numbers for line probes and show source context.
         Keep these three settings in a Release build or line probes will not bind. -->
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <IncludeSymbolsInSingleFile>false</IncludeSymbolsInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.2.1" />
  </ItemGroup>

</Project>
